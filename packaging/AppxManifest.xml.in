<?xml version="1.0" encoding="utf-8"?>
<!--
  Sparse package for copilot-ask.

  Sparse, not full: AllowExternalContent keeps copilot-ask.exe at a real path
  under %LOCALAPPDATA%\Programs so the HKCU\...\Run autostart value stays valid
  across upgrades, and so nothing virtualizes the %APPDATA%\copilot-ask writes
  that hold config.toml. See docs/superpowers/specs/2026-09-15-packaging-and-install-design.md.

  @VERSION@ and @PUBLISHER@ are substituted by install.ps1. Publisher must
  match the signing certificate subject exactly or deployment fails 0x800B0109,
  and Version is derived from Cargo.toml so the two cannot drift.

  Note for editors: a double hyphen is illegal inside an XML comment, and
  makeappx reports it only as a generic parse error at a column number.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap10 rescap">

  <Identity Name="RaaifYousuf.CopilotAsk"
            Publisher="@PUBLISHER@"
            Version="@VERSION@"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>copilot-ask</DisplayName>
    <PublisherDisplayName>Raaif Yousuf</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- The sparse-package opt-in. Without it, Add-AppxPackage -ExternalLocation
         is rejected and the executable would have to live inside WindowsApps. -->
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Dependencies>
    <!-- 22621 is the floor for the Copilot hardware key picker. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22621.0" MaxVersionTested="10.0.26200.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <!-- Executable is resolved against the external location, not the package. -->
    <Application Id="CopilotAsk"
                 Executable="copilot-ask.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="copilot-ask"
        Description="Check what's on screen with a vision model"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- What makes the app selectable under Settings > Bluetooth & devices >
             Keyboard > Customize Copilot key on keyboard > Custom. All four
             attributes are required; PublicFolder names a folder the shell may
             read through a broker, declared but empty. -->
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.windows.copilotkeyprovider"
                             Id="CopilotAsk"
                             DisplayName="copilot-ask"
                             Description="Check what's on screen with a vision model"
                             PublicFolder="Public" />
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
